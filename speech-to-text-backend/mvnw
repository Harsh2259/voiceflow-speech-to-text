#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper for Linux/macOS/Git Bash
# ----------------------------------------------------------------------------
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

WRAPPER_PROP="$APP_HOME/.mvn/wrapper/maven-wrapper.properties"
DIST_URL=$(grep "distributionUrl=" "$WRAPPER_PROP" | cut -d'=' -f2)

MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin/apache-maven-3.9.8"

if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
    echo "[INFO] Maven not found. Downloading Maven..."
    mkdir -p "$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin"
    curl -sS -L -o "$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin/maven.zip" "$DIST_URL"
    unzip -q "$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin/maven.zip" -d "$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin"
    rm "$HOME/.m2/wrapper/dists/apache-maven-3.9.8-bin/maven.zip"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
